IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=user@example.com
IMAP_PASSWORD_FILE=/run/secrets/imap_password

# EN: Exact paths, comma separated. The Reader will not expose any other folder.
# IT: Percorsi esatti, separati da virgola. Il Reader non mostrerà altre cartelle.
MAILBOX_ALLOWLIST=INBOX,INBOX.Social,INBOX.Newsletters,INBOX.Updates
MAX_SEARCH_RESULTS=100
MAX_MESSAGE_BYTES=5000000
CHARACTER_LIMIT=30000
IMAP_CONNECTION_TIMEOUT_MS=15000
IMAP_SOCKET_TIMEOUT_MS=60000

MCP_HOST=0.0.0.0
MCP_PORT=3333
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_TOKEN_FILE=/run/secrets/reader_mcp_token

# EN: Language of tool descriptions and messages returned to the MCP client.
# IT: Lingua delle descrizioni dei tool e dei messaggi restituiti al client MCP.
# en | it
MAIL_MCP_LOCALE=en

# EN: Optional: direct validation of Cloudflare Access JWTs.
#     Configure all three variables or leave them all empty.
# IT: Opzionale: validazione diretta dei JWT Cloudflare Access.
#     Configurare tutte e tre le variabili oppure lasciarle tutte vuote.
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUD=replace-with-access-application-audience
# CLOUDFLARE_ACCESS_EMAILS=user@example.com
