# =============================================================================
# EN: Single configuration file for the whole stack. Copy to .env in the
#     repository root, then fill it in. Passwords do NOT belong here: they stay
#     in local-config/secrets/ and are mounted per service as Docker secrets.
# IT: File di configurazione unico per l'intero stack. Copiarlo in .env nella
#     radice del repository e compilarlo. Le password NON vanno qui: restano in
#     local-config/secrets/ e sono montate per servizio come Docker secret.
#
# EN: There is deliberately no password and no secret path in this file. Both
#     live in compose.yaml and local-config/secrets/, so nothing here can be
#     turned into an inline credential by mistake.
# IT: In questo file non c'è deliberatamente nessuna password né alcun percorso
#     di secret. Entrambi stanno in compose.yaml e in local-config/secrets/,
#     così nulla qui può diventare per errore una credenziale in chiaro.
# =============================================================================

# --- Compose -----------------------------------------------------------------
# EN: Published image, for example ghcr.io/federicokalik/mail-mcp-suite:3.0.0
#     Keep mail-mcp-suite:local only when building with compose.build.yaml.
# IT: Immagine pubblicata, ad esempio
#     ghcr.io/federicokalik/mail-mcp-suite:3.0.0
#     Usare mail-mcp-suite:local solo compilando con compose.build.yaml.
MAIL_MCP_IMAGE=mail-mcp-suite:local

# EN: Directory holding secrets/. Must stay outside Git.
# IT: Directory che contiene secrets/. Deve restare fuori da Git.
MAIL_MCP_CONFIG_DIR=./local-config

# EN: Host interface for the published ports. Keep loopback unless LAN access
#     is deliberately required.
# IT: Interfaccia host per le porte pubblicate. Mantenere il loopback salvo che
#     l'accesso dalla LAN sia deliberatamente necessario.
MAIL_MCP_BIND_ADDRESS=127.0.0.1

# EN: Language of tool descriptions, approval page and stored messages.
# IT: Lingua delle descrizioni dei tool, della pagina di approvazione e dei
#     messaggi salvati.
# en | it
MAIL_MCP_LOCALE=en

# --- Mail account ------------------------------------------------------------
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=user@example.com

SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=user@example.com
FROM_NAME=Example User
FROM_ADDRESS=user@example.com

ALLOW_INSECURE_MAIL_TRANSPORT=false
IMAP_CONNECTION_TIMEOUT_MS=15000
IMAP_SOCKET_TIMEOUT_MS=60000
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=60000

# --- Reader ------------------------------------------------------------------
# EN: Exact paths, comma separated. The Reader will not expose any other folder.
# IT: Percorsi esatti, separati da virgola. Il Reader non mostrerà altre cartelle.
MAILBOX_ALLOWLIST=INBOX,INBOX.Social,INBOX.Newsletters,INBOX.Updates
MAX_SEARCH_RESULTS=100
MAX_MESSAGE_BYTES=5000000
READER_CHARACTER_LIMIT=30000

# EN: Add the public Reader hostname here when publishing through a tunnel.
# IT: Aggiungere qui l'hostname pubblico del Reader quando si pubblica con un
#     tunnel.
READER_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Actions -----------------------------------------------------------------
WORKER_REQUEST_TIMEOUT_MS=15000
ACTIONS_CHARACTER_LIMIT=20000

# EN: Must be reachable from the user's browser, including from the sandboxed
#     iframe that renders the in-chat approval app.
# IT: Deve essere raggiungibile dal browser dell'utente, incluso l'iframe
#     sandboxed che mostra l'app di approvazione in chat.
APPROVAL_BASE_URL=http://127.0.0.1:7337

# EN: How long a tool call may wait on a URL-mode elicitation, in ms. Applies
#     only to clients that cannot render the approval app. 0 disables it.
# IT: Attesa massima di una chiamata su un'elicitation in URL mode, in ms. Vale
#     solo per i client che non renderizzano l'app di approvazione. 0 disattiva.
APPROVAL_WAIT_MS=120000

# EN: Add the public Actions hostname here when publishing through a tunnel.
# IT: Aggiungere qui l'hostname pubblico di Actions quando si pubblica con un
#     tunnel.
PROXY_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Worker: approval --------------------------------------------------------
APPROVAL_TTL_MINUTES=1440
# EN: IANA name, for example Europe/Rome.
# IT: Nome IANA, ad esempio Europe/Rome.
APPROVAL_TIMEZONE=UTC
OUTBOX_PATH=/data/outbox.json

# EN: Add the public approval hostname here when publishing through a tunnel.
# IT: Aggiungere qui l'hostname pubblico di approvazione quando si pubblica con
#     un tunnel.
WORKER_ALLOWED_HOSTS=localhost,127.0.0.1,worker

# EN: Set to 1 only when a single trusted reverse proxy, such as cloudflared,
#     sits in front of the Worker. Leave 0 for direct local or LAN access.
# IT: Impostare a 1 solo quando un unico reverse proxy fidato, come cloudflared,
#     è davanti al Worker. Lasciare 0 per accesso diretto locale o LAN.
TRUST_PROXY_HOPS=0

# --- Worker: sending policy --------------------------------------------------
MAX_RECIPIENTS=10
RECIPIENT_DOMAIN_ALLOWLIST=
RECIPIENT_DOMAIN_DENYLIST=
MAX_SCHEDULE_DAYS=365
MIN_SCHEDULE_LEAD_SECONDS=60
SCHEDULER_INTERVAL_MS=2000

# --- Worker: approved IMAP moves ---------------------------------------------
# EN: Used by the Worker only, after approval.
# IT: Usate esclusivamente dal Worker, dopo l'approvazione.
MOVE_IMAP_HOST=mail.example.com
MOVE_IMAP_PORT=993
MOVE_IMAP_SECURE=true
MOVE_IMAP_USER=user@example.com
MOVE_SOURCE_ALLOWLIST=INBOX,INBOX.Social,INBOX.Newsletters,INBOX.Updates
MOVE_DESTINATION_ALLOWLIST=INBOX,INBOX.Social,INBOX.Newsletters,INBOX.Updates
MOVE_MAX_BATCH=25

# --- Worker: Sent copy -------------------------------------------------------
# EN: If true, the Worker stores in IMAP exactly the same MIME delivered to SMTP.
# IT: Se true, il Worker salva in IMAP esattamente lo stesso MIME consegnato a SMTP.
SAVE_SENT_COPY=false
SENT_IMAP_HOST=mail.example.com
SENT_IMAP_PORT=993
SENT_IMAP_SECURE=true
SENT_IMAP_USER=user@example.com
SENT_MAILBOX=Sent

# --- Cloudflare Access (optional) --------------------------------------------
# EN: Reader and Actions are separate Access applications, so each has its own
#     audience. Configure the team domain, both audiences and the email
#     allowlist together, or leave them all commented out.
# IT: Reader e Actions sono applicazioni Access distinte, quindi ognuna ha la
#     propria audience. Configurare team domain, entrambe le audience e
#     l'allowlist delle email insieme, oppure lasciarle tutte commentate.
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CLOUDFLARE_ACCESS_EMAILS=user@example.com
# READER_ACCESS_AUD=replace-with-reader-application-audience
# ACTIONS_ACCESS_AUD=replace-with-actions-application-audience
