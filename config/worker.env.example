SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=user@example.com
SMTP_PASSWORD_FILE=/run/secrets/smtp_password
FROM_NAME=Example User
FROM_ADDRESS=user@example.com
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=60000

# EN: IMAP credentials used by the Worker only, after approval.
# IT: Credenziali IMAP usate esclusivamente dal Worker dopo approvazione.
MOVE_IMAP_HOST=mail.example.com
MOVE_IMAP_PORT=993
MOVE_IMAP_SECURE=true
MOVE_IMAP_USER=user@example.com
MOVE_IMAP_PASSWORD_FILE=/run/secrets/imap_password
MOVE_SOURCE_ALLOWLIST=INBOX,INBOX.Social,INBOX.Newsletters,INBOX.Updates
MOVE_DESTINATION_ALLOWLIST=INBOX,INBOX.Social,INBOX.Newsletters,INBOX.Updates
MOVE_MAX_BATCH=25

OUTBOX_PATH=/data/outbox.json
APPROVAL_TTL_MINUTES=1440
APPROVAL_TIMEZONE=UTC

# EN: Language of the browser approval page and of stored outcome messages.
# IT: Lingua della pagina di approvazione nel browser e dei messaggi di esito salvati.
# en | it
MAIL_MCP_LOCALE=en
APPROVAL_SECRET_FILE=/run/secrets/approval_secret
APPROVAL_CSRF_SECRET_FILE=/run/secrets/approval_csrf_secret
QUEUE_API_TOKEN_FILE=/run/secrets/queue_api_token

MAX_RECIPIENTS=10
RECIPIENT_DOMAIN_ALLOWLIST=
RECIPIENT_DOMAIN_DENYLIST=
MAX_SCHEDULE_DAYS=365
MIN_SCHEDULE_LEAD_SECONDS=60
SCHEDULER_INTERVAL_MS=2000

# EN: If true, the worker stores in IMAP exactly the same MIME delivered to SMTP.
# IT: Se true, il worker salva in IMAP esattamente lo stesso MIME consegnato a SMTP.
SAVE_SENT_COPY=false
SENT_IMAP_HOST=mail.example.com
SENT_IMAP_PORT=993
SENT_IMAP_SECURE=true
SENT_IMAP_USER=user@example.com
SENT_IMAP_PASSWORD_FILE=/run/secrets/imap_password
SENT_MAILBOX=Sent

WORKER_HOST=0.0.0.0
WORKER_PORT=7337
WORKER_ALLOWED_HOSTS=localhost,127.0.0.1,worker

# EN: Set to 1 only when a single trusted reverse proxy, such as cloudflared,
#     sits in front of the Worker. Leave 0 for direct local or LAN access.
# IT: Impostare a 1 solo quando un unico reverse proxy fidato, come cloudflared,
#     è davanti al Worker. Lasciare 0 per accesso diretto locale o LAN.
TRUST_PROXY_HOPS=0
