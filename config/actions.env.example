WORKER_INTERNAL_URL=http://worker:7337
WORKER_REQUEST_TIMEOUT_MS=15000

# EN: Must be reachable from the user's browser, including from the sandboxed
#     iframe that renders the in-chat approval app.
# IT: Deve essere raggiungibile dal browser dell’utente, incluso l’iframe
#     sandboxed che mostra l’app di approvazione in chat.
APPROVAL_BASE_URL=http://127.0.0.1:7337

# EN: Seconds a tool call may wait on a URL-mode elicitation, in ms. Applies
#     only to clients that cannot render the approval app. 0 disables it.
# IT: Attesa massima di una chiamata su un’elicitation in URL mode, in ms. Vale
#     solo per i client che non renderizzano l’app di approvazione. 0 disattiva.
APPROVAL_WAIT_MS=120000

# EN: Language of tool descriptions and messages returned to the MCP client.
# IT: Lingua delle descrizioni dei tool e dei messaggi restituiti al client MCP.
# en | it
MAIL_MCP_LOCALE=en

MCP_HOST=0.0.0.0
MCP_PORT=3334
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,actions
MCP_TOKEN_FILE=/run/secrets/actions_mcp_token
QUEUE_API_TOKEN_FILE=/run/secrets/queue_api_token
CHARACTER_LIMIT=20000
